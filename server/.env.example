# ── Server ───────────────────────────────────────────────
PORT=8787
NODE_ENV=production
# This API's public URL (Cashfree sends payment webhooks here)
PUBLIC_API_URL=https://glint-api.strophic.in
# Your Vercel site (desktop sign-in link + CORS)
WEB_URL=https://glint.strophic.in
# Extra allowed browser origins, comma separated (e.g. Vercel preview URLs)
CORS_ORIGINS=https://glint.strophic.in
BRAND_NAME=Glint

# ── Database (VibeDB) ────────────────────────────────────
# On the VM:  sudo vibedb project credentials glint --role owner --url local-direct
# In Docker, replace 127.0.0.1 with host.docker.internal.
DATABASE_URL=postgresql://glint_owner:PASSWORD@host.docker.internal:5432/glint?sslmode=disable
DB_POOL_SIZE=10

# ── Auth ─────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Comma separated emails that can open /admin
ADMIN_EMAILS=you@gmail.com
# Local development only: email login without Google. NEVER enable in production.
DEV_LOGIN=0

# ── AI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# 1 = simulated transcripts and answers (no OpenAI calls). Useful for UI work.
MOCK_AI=0
# Models users can pick in the app (GPT-6 Luna / 6.1 Terra / 6.1 Sol). Models your OpenAI
# project can't use are hidden automatically. Use ALLOWED_MODELS=gpt-6-luna for Luna only.
ALLOWED_MODELS=gpt-6-luna,gpt-6.1-terra,gpt-6.1-sol
DEFAULT_MODEL=gpt-6-luna
# priority = OpenAI's low-latency lane (~0.6 s to first word). Empty = default lane.
OPENAI_SERVICE_TIER=priority
MAX_OUTPUT_TOKENS=1400
# Speech to text: streaming model for the other side, cheaper model for your mic
STT_MODEL_THEM=gpt-live-transcribe
STT_MODEL_YOU=gpt-transcribe
STT_DELAY=low
# If the project has no realtime access to a model (e.g. right after enabling it), Glint transcribes
# each finished sentence with this model instead, then retries realtime every 10 minutes.
STT_REST_MODEL=gpt-transcribe
# Optional language hints, e.g. en,hi
STT_LANGUAGES=

# ── Metering (the admin panel can change these live) ─────
TRIAL_SECONDS=1200
ANSWER_SECONDS=30
IDLE_TIMEOUT_S=300
VALIDITY_DAYS=180

# ── Cashfree Payments ────────────────────────────────────
# Dashboard → Developers → API Keys. Start with sandbox keys + CASHFREE_ENV=sandbox.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
