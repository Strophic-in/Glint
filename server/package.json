{
  "name": "glint-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "postgres": "^3.4.9",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
