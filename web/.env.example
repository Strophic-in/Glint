# Base URL of the Glint API (Oracle server). No trailing slash.
PUBLIC_API_URL=http://localhost:8787

# Google OAuth "Web application" client ID (Google Cloud Console → Credentials).
# Add your Vercel domain (and http://localhost:5173) to Authorized JavaScript origins.
PUBLIC_GOOGLE_CLIENT_ID=

# Where the Windows installer is hosted (GitHub Releases, Oracle /downloads, etc.)
PUBLIC_DOWNLOAD_URL=https://github.com/your-org/glint/releases/latest

# "1" shows a dev email login (calls POST /v1/auth/dev). Never set in production.
PUBLIC_DEV_LOGIN=

PUBLIC_BRAND_NAME=Glint
PUBLIC_SUPPORT_EMAIL=support@example.com
